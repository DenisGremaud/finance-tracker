DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_tracker
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# Public URL of the frontend, used to build the password reset link.
FRONTEND_URL=http://localhost:5173

# Email sending, used only for "mot de passe oublié".
# Leave SMTP_HOST empty in development: the reset link is written to the
# backend logs instead of being emailed, so the flow stays testable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=Finance Tracker <noreply@votredomaine.com>
